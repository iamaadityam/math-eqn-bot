# =======================================================
# Graphshot Multiplayer Arena — Environment Configuration
# =======================================================

# Server network binding
PORT=3000
HOST=0.0.0.0

# Database URL: PostgreSQL database (e.g. AWS RDS or local PostgreSQL)
DATABASE_URL=postgresql://graphshot:REPLACE_WITH_DB_PASSWORD@your-rds-host:5432/graphshot

# rCTF OAuth2 Authentication
RCTF_BASE_URL=https://rctf.example.com
APP_BASE_URL=https://graphshot.example.com
RCTF_CLIENT_ID=REPLACE_WITH_EXTERNAL_APP_CLIENT_ID
RCTF_CLIENT_SECRET=REPLACE_WITH_EXTERNAL_APP_CLIENT_SECRET

# Timed round intervals (in seconds)
ROUND_PERIOD_SECONDS=300
ENTRY_WINDOW_SECONDS=60
CODING_SECONDS=120

# Cookie security: true for HTTPS in production, false for local HTTP
COOKIE_SECURE=false

# Development mode: set to true to enable instant local dev login without an rCTF server
DEV_AUTH=false
